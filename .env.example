# ProtocolOps — copy to .env and adjust.
# Mock mode is the default. Local/CI work with zero Google credentials.

PROTOCOLOPS_MOCK=true
PROTOCOLOPS_SITE_URL=https://docs.helios.example/
PROTOCOLOPS_DOCS_PATH=fixtures/docs
# Optional public docs origin to crawl instead of (or after) the local folder.
# PROTOCOLOPS_DOCS_URL=https://docs.helios.example/
PROTOCOLOPS_OUTPUT_DIR=output
PROTOCOLOPS_BRAND=Helios Protocol
PROTOCOLOPS_DRAFT_COUNT=3

# --- Google Search Console ---
# Option A: OAuth desktop client JSON from Google Cloud Console.
# GSC_OAUTH_CLIENT_FILE=/absolute/path/to/oauth-client.json
# GSC_TOKEN_FILE=.protocolops/token.json
#
# Option B: service account JSON. Add the SA email as a Search Console user
# (Owner or Full user) on the property first.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Then flip mock off:
# PROTOCOLOPS_MOCK=false

# --- Optional GA4 (env-gated stub; fixture data when mock or no property) ---
PROTOCOLOPS_GA4=false
# GA4_PROPERTY_ID=properties/123456789

# --- Telegram report card (omit token for dry-run) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Desk ---
PROTOCOLOPS_DESK_HOST=127.0.0.1
PROTOCOLOPS_DESK_PORT=8787
